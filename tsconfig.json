{
	// Solution-style root: it owns no files itself. Each package sets its own
	// `include`, `rootDir` and `outDir`, so `tsc -b` here emits nothing at the root.
	"files": [],
	"references": [
		{
			"path": "./packages/lit-analyzer"
		},
		{
			"path": "./packages/lit-language-server"
		},
		{
			"path": "./packages/ts-lit-plugin"
		},
		{
			"path": "./packages/ts-simple-type"
		},
		{
			"path": "./packages/vscode-lit-plugin"
		},
		{
			"path": "./packages/web-component-analyzer"
		}
	],
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [
			"node"
		],
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"noUnusedLocals": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"incremental": true
	}
}
{
	"include": [
		"${configDir}/**/*.ts",
		"${configDir}/**/*.d.ts"
	],
	"compilerOptions": {
		"module": "nodenext",
		"outDir": "${configDir}/lib",
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"noUnusedLocals": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"incremental": true
	}
}
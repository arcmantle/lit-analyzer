{
	"name": "@arcmantle/lit-language-server",
	"private": true,
	"version": "1.5.0",
	"description": "Standalone language server that serves lit-html analysis over the Language Server Protocol.",
	"author": "arcmantle",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/lit-analyzer.git"
	},
	"main": "lib/main.js",
	"scripts": {
		"bench": "pnpm run build && vitest bench --run src/test/repeat-analysis.bench.ts",
		"watch": "tsc --watch",
		"build": "rm -rf lib .tsbuildinfo && tsc --build --pretty",
		"rebuild": "rm -rf lib .tsbuildinfo && tsc --build --pretty",
		"test": "pnpm run build && vitest run"
	},
	"dependencies": {
		"@arcmantle/lit-analyzer": "workspace:*",
		"@arcmantle/web-component-analyzer": "workspace:*",
		"vscode-languageserver": "^10.0.0",
		"vscode-languageserver-textdocument": "^1.0.12"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "catalog:",
		"vitest": "^4.1.10",
		"vscode-jsonrpc": "^9.0.0"
	},
	"type": "module"
}
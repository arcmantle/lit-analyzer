{
	"name": "@arcmantle/web-component-analyzer",
	"version": "2.0.0",
	"private": true,
	"description": "CLI that analyzes web components. Internal to this repository and not published.",
	"author": "Rune Mehlsen",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/web-component-analyzer.git"
	},
	"type": "module",
	"main": "lib/api.js",
	"types": "lib/api.d.ts",
	"exports": {
		".": {
			"types": "./lib/api.d.ts",
			"default": "./lib/api.js"
		}
	},
	"bin": {
		"wca": "cli.js",
		"web-component-analyzer": "cli.js"
	},
	"scripts": {
		"build": "rm -rf lib .tsbuildinfo && tsc --build --pretty",
		"rebuild": "rm -rf lib .tsbuildinfo && tsc --build --pretty",
		"watch": "tsc --build --watch",
		"test": "vitest run"
	},
	"dependencies": {
		"fast-glob": "^3.2.2",
		"typescript": "catalog:",
		"yargs": "^17.7.2"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/yargs": "^17.0.28",
		"vitest": "^4.1.10"
	}
}
{
	"name": "web-component-analyzer",
	"version": "2.0.0",
	"description": "CLI that analyzes web components",
	"author": "Rune Mehlsen",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/web-component-analyzer.git"
	},
	"keywords": [
		"web components",
		"web",
		"components"
	],
	"type": "module",
	"main": "lib/api.js",
	"types": "lib/api.d.ts",
	"exports": {
		".": {
			"types": "./lib/api.d.ts",
			"default": "./lib/api.js"
		}
	},
	"bin": {
		"wca": "cli.js",
		"web-component-analyzer": "cli.js"
	},
	"files": [
		"lib",
		"cli.js"
	],
	"scripts": {
		"build": "tsc --build --pretty",
		"rebuild": "tsc --build --force --pretty",
		"watch": "tsc --build --watch"
	},
	"dependencies": {
		"fast-glob": "^3.2.2",
		"ts-simple-type": "workspace:*",
		"typescript": "catalog:",
		"yargs": "^17.7.2"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/yargs": "^17.0.28"
	}
}

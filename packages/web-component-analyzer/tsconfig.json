{
	"extends": "../../tsconfig.json",
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	],
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"outDir": "./lib",
		"lib": [
			"es2022",
			"dom"
		],
		"types": [
			"node"
		],
		"sourceMap": true,
		"rootDir": "./src",
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		// Vendored upstream source. Its visitor and discovery callbacks use an
		// implicit `return undefined` as the "no result, keep traversing" signal,
		// so this check is relaxed for this package only rather than rewriting
		// its control flow.
		"noImplicitReturns": false,
		"tsBuildInfoFile": "./.tsbuildinfo"
	}
}

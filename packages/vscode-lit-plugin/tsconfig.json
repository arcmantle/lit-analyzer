{
	"extends": "../../tsconfig.json",
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules",
		"./src/test/fixtures"
	],
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"outDir": "out",
		"lib": [
			"es2022"
		],
		"types": [
			"node"
		],
		"sourceMap": true,
		"rootDir": "src",
		"tsBuildInfoFile": "./.tsbuildinfo"
	}
}
{
	"name": "ts-simple-type",
	"version": "2.0.0-next.0",
	"description": "Relationship type checker functions for Typescript types.",
	"author": "runem",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/ts-simple-type.git"
	},
	"keywords": [
		"typescript",
		"ast",
		"typechecker",
		"type"
	],
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "tsc --build --pretty",
		"rebuild": "tsc --build --force --pretty",
		"watch": "tsc --build --watch",
		"playground": "node run-playground.ts",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	}
}
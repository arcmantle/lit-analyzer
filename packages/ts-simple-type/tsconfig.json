{
	"extends": "../../tsconfig.json",
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./lib",
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		// Vendored upstream source. Its visitor callbacks use an implicit
		// `return undefined` as the "no result, keep traversing" signal, and
		// `simple-type-to-string.ts` has one documented intentional switch
		// fallthrough. Both are deliberate upstream, so these two checks are
		// relaxed for this package only rather than rewriting its logic.
		"noImplicitReturns": false,
		"noFallthroughCasesInSwitch": false,
		"tsBuildInfoFile": "./.tsbuildinfo"
	}
}
{
	"name": "@arcmantle/lit-analyzer",
	"version": "1.5.0",
	"description": "CLI that type checks bindings in lit-html templates",
	"author": "arcmantle",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/lit-analyzer.git"
	},
	"keywords": [
		"lit-html",
		"lit",
		"lit-element",
		"javascript",
		"typescript",
		"web components",
		"web",
		"components",
		"tagged",
		"template"
	],
	"bin": {
		"lit-analyzer": "cli.js"
	},
	"type": "module",
	"main": "dist/lib/index.js",
	"types": "dist/lib/index.d.ts",
	"scripts": {
		"build": "rm -rf dist .tsbuildinfo && tsc --build --pretty",
		"rebuild": "rm -rf dist .tsbuildinfo && tsc --build --pretty",
		"prepack": "pnpm run rebuild",
		"prepublishOnly": "pnpm test",
		"test": "vitest run && pnpm run check-version",
		"test:all": "pnpm test",
		"test:watch": "vitest",
		"check-version": "node src/scripts/check-version.ts"
	},
	"files": [
		"/dist/lib/",
		"cli.js"
	],
	"dependencies": {
		"@vscode/web-custom-data": "^0.4.2",
		"chalk": "^2.4.2",
		"didyoumean2": "7.0.4",
		"fast-glob": "^3.2.11",
		"parse5": "8.0.1",
		"vscode-css-languageservice": "6.3.7",
		"vscode-html-languageservice": "5.5.1",
		"vscode-languageserver-textdocument": "^1.0.12",
		"vscode-languageserver-types": "^3.17.5",
		"@arcmantle/web-component-analyzer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tslib": "^2.0.0",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	}
}
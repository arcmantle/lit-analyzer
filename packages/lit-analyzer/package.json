{
	"name": "lit-analyzer",
	"version": "3.0.0",
	"description": "CLI that type checks bindings in lit-html templates",
	"author": "runem",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/lit-analyzer.git"
	},
	"keywords": [
		"lit-html",
		"lit",
		"lit-element",
		"javascript",
		"typescript",
		"web components",
		"web",
		"components",
		"tagged",
		"template"
	],
	"bin": {
		"lit-analyzer": "cli.js"
	},
	"scripts": {
		"build": "tsc --build --pretty",
		"rebuild": "tsc --build --force --pretty",
		"prepack": "pnpm run rebuild",
		"prepublishOnly": "pnpm test",
		"test": "vitest run && pnpm run check-version",
		"test:all": "pnpm test",
		"test:watch": "vitest",
		"check-version": "node src/scripts/check-version.ts"
	},
	"main": "dist/index.js",
	"files": [
		"/dist/lib/",
		"/dist/index.js",
		"/dist/index.d.ts",
		"/dist/index.d.ts.map",
		"cli.js"
	],
	"dependencies": {
		"@vscode/web-custom-data": "^0.4.2",
		"chalk": "^2.4.2",
		"didyoumean2": "7.0.4",
		"fast-glob": "^3.2.11",
		"parse5": "8.0.1",
		"ts-simple-type": "workspace:*",
		"vscode-css-languageservice": "6.3.7",
		"vscode-html-languageservice": "5.5.1",
		"vscode-languageserver-types": "^3.17.5",
		"web-component-analyzer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tslib": "^2.0.0",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	},
	"contributors": [
		{
			"name": "Rune Mehlsen",
			"url": "https://twitter.com/runemehlsen",
			"img": "https://avatars2.githubusercontent.com/u/5372940?s=460&v=4"
		},
		{
			"name": "Andreas Mehlsen",
			"url": "https://twitter.com/andreasmehlsen",
			"img": "https://avatars1.githubusercontent.com/u/6267397?s=460&v=4"
		},
		{
			"name": "You?",
			"img": "https://joeschmoe.io/api/v1/random",
			"url": "https://github.com/runem/lit-analyzer/blob/master/CONTRIBUTING.md"
		}
	],
	"types": "dist/index.d.ts",
	"type": "module"
}
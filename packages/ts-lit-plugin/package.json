{
	"name": "ts-lit-plugin",
	"version": "2.0.2",
	"description": "Typescript plugin that adds type checking and code completion to lit-html",
	"author": "runem",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/runem/lit-analyzer.git"
	},
	"keywords": [
		"lit-html",
		"lit",
		"lit-element",
		"javascript",
		"typescript",
		"web components",
		"web",
		"components",
		"tagged",
		"template"
	],
	"scripts": {
		"watch": "tsc --watch",
		"build": "tsc --build --pretty",
		"rebuild": "tsc --build --force --pretty",
		"prepack": "pnpm run rebuild",
		"test": "pnpm run build"
	},
	"main": "index.cjs",
	"files": [
		"/lib/",
		"/html-documentation/",
		"index.cjs"
	],
	"dependencies": {
		"lit-analyzer": "workspace:*",
		"web-component-analyzer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"rimraf": "^3.0.2",
		"typescript": "catalog:"
	},
	"contributors": [
		{
			"name": "Rune Mehlsen",
			"url": "https://twitter.com/runemehlsen",
			"img": "https://avatars2.githubusercontent.com/u/5372940?s=460&v=4"
		},
		{
			"name": "Andreas Mehlsen",
			"url": "https://twitter.com/andreasmehlsen",
			"img": "https://avatars1.githubusercontent.com/u/6267397?s=460&v=4"
		},
		{
			"name": "You?",
			"img": "https://joeschmoe.io/api/v1/random",
			"url": "https://github.com/runem/lit-analyzer/blob/master/CONTRIBUTING.md"
		}
	],
	"type": "module"
}